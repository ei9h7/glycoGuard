# GlycoGuard — Environment Variables
#
# Copy this file to .env and fill in your own values.
# The .env file is gitignored and must NEVER be committed.

# ── Firebase (browser — safe to expose) ───────────────────────────────────────
# Firebase console → Project Settings → Your Apps → SDK setup and configuration
# https://console.firebase.google.com
# These values identify your Firebase project but do not grant API access on
# their own — they are intended to be public.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Cloud Functions — server-side secrets (never set as VITE_ vars) ───────────
# These keys are used only by the Firebase Cloud Functions in functions/.
# Set them with the Firebase CLI:
#
#   firebase functions:secrets:set OPENROUTER_API_KEY
#   firebase functions:secrets:set VOYAGE_API_KEY
#   firebase functions:secrets:set PINECONE_API_KEY
#   firebase functions:secrets:set PINECONE_INDEX
#
# Or via the Firebase console → Functions → Secret Manager.
# Do NOT add these to Vercel env vars or prefix them with VITE_.
#
# OPENROUTER_API_KEY   — https://openrouter.ai → Keys
# VOYAGE_API_KEY       — https://dashboard.voyageai.com → API Keys
# PINECONE_API_KEY     — https://app.pinecone.io → API Keys
# PINECONE_INDEX       — the index name you created (e.g. glycoguard-dev)
