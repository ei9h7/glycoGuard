# GlycoGuard — Environment Variables
#
# Copy this file to .env and fill in your own values.
# The .env file is gitignored and must NEVER be committed.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  SECURITY WARNING — READ BEFORE DEPLOYING                               │
# │                                                                         │
# │  These VITE_ prefixed variables are bundled into the browser build and  │
# │  are visible to anyone who inspects the JavaScript bundle.              │
# │                                                                         │
# │  This is acceptable for single-user development with a private repo.    │
# │  It is NOT acceptable for a public or multi-user production deployment. │
# │                                                                         │
# │  Before going to production:                                            │
# │    1. Deploy the Firebase Cloud Functions in the functions/ folder.     │
# │    2. Move all OpenRouter, Voyage AI, and Pinecone calls to those       │
# │       functions so API keys never reach the browser.                    │
# │    3. Remove VITE_OPENROUTER_API_KEY, VITE_VOYAGE_API_KEY, and         │
# │       VITE_PINECONE_API_KEY from this file and from Vercel env vars.    │
# │                                                                         │
# │  The service interfaces (vectorStore.js, patternEngine.js) are          │
# │  designed so this swap is a one-file change per service.                │
# └─────────────────────────────────────────────────────────────────────────┘

# ── Firebase ──────────────────────────────────────────────────────────────────
# Firebase console → Project Settings → Your Apps → SDK setup and configuration
# https://console.firebase.google.com

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── OpenRouter ────────────────────────────────────────────────────────────────
# AI gateway — routes to Claude, GPT-4, and others via a single API.
# https://openrouter.ai → Keys
# Used by: AI assistant (AI.jsx), meal recommendations (Meals.jsx)

VITE_OPENROUTER_API_KEY=

# ── Voyage AI ─────────────────────────────────────────────────────────────────
# Embedding model for all vector upserts and semantic searches.
# Uses voyage-code-3 (1024 dimensions).
# https://dashboard.voyageai.com → API Keys

VITE_VOYAGE_API_KEY=

# ── Pinecone ──────────────────────────────────────────────────────────────────
# Serverless vector store. Create a serverless index (AWS us-east-1, 1024 dims,
# cosine metric) before running the app.
# https://app.pinecone.io → API Keys / your index page

# API key from the Pinecone console
VITE_PINECONE_API_KEY=

# Host URL for your specific index — found on the index detail page.
# Looks like: https://your-index-name-xxxxxxxxxx.svc.aped-xxxx-xxxx.pinecone.io
VITE_PINECONE_HOST=

# The name you gave your index when creating it (e.g. glycoguard-dev)
VITE_PINECONE_INDEX=
